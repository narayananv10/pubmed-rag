# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real secrets.

# NCBI Entrez (PubMed). Optional but recommended:
# raises rate limit from 3 req/s to 10 req/s. Free at:
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# NCBI E-utilities require an email contact for any programmatic access.
NCBI_EMAIL=

# Voyage AI (embeddings + reranker). Free tier covers this project.
# https://dash.voyageai.com/
VOYAGE_API_KEY=

# Anthropic (Claude generator + LLM-judge for eval).
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
